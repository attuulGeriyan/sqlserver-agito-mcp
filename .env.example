# Copy this file to .env or set these variables in your shell / .mcp.json.
# Note: a .env file is not auto-loaded by the MCP server — set these in the
# `env` block of your .mcp.json (see README), OR export them in your shell
# when running standalone test scripts.

# REQUIRED — your local SQL Server connection target.
# Examples:
#   (localdb)\MSSQLLocalDB        <-- default SQL Server LocalDB instance
#   (localdb)\SQLLocalEXP01       <-- custom LocalDB instance name
#   localhost                     <-- default SQL Server install
#   localhost\SQLEXPRESS          <-- SQL Server Express
#   tcp:my-server.company.com,1433
SQLSERVER_HOST=(localdb)\MSSQLLocalDB

# OPTIONAL — explicit project-name → database overrides for cases where the
# automatic resolver (MTM<project> + fuzzy stem match) picks the wrong DB.
# JSON object, keys are project names, values are exact database names.
# Example: when the project "Foo" should map to a DB called "MyFooDB":
# MCP_PROJECT_OVERRIDES={"Foo":"MyFooDB","Legacy":"OldDb"}
